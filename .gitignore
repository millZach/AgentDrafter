# Client material never enters this public repo.
# Real drawings are tested from folders outside the repository.
*.dwg
*.dxf
*.bak
*.dwl
*.dwl2
# Renders of the examples: build them again from the sheet descriptions.
examples/*.png
# What building and plotting the demo plant writes: build and plot it again.
examples/demo-plant/dwg/
!demo-plant/**/*.dwg
!demo-plant/**/*.dxf
!tests/fixtures/**/*.dwg
!tests/fixtures/**/*.dxf

# Secrets
.env
.env.*

# Run files and scratch
.zstack/

# Build output and tool folders
target/
node_modules/
dist/
__pycache__/
*.pyc
.venv/

# The viewer's WebAssembly module and its glue, built by `npm run build`
# in viewer/ (viewer/dist/ is ignored above, as dist/).
viewer/src/wasm/
