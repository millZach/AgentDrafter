# Client material never enters this public repo.
# Real drawings are tested from folders outside the repository.
*.dwg
*.dxf
*.mirror.yaml
*.mirror.tmp
*.changes.json
*.rev*.pdf
*.rev.tmp
.agentdrafter-*.tmp
.agentdrafter-*.old
*.agentdrafter-undo.old
**/.agentdrafter/originals/
*.bak
*.dwl
*.dwl2
# Renders of the examples: build them again from the sheet descriptions.
examples/*.png
# What building and plotting the demo plant, the panel set, the two-kinds set
# and the transforms set
# writes: build and plot them again.
examples/demo-plant/dwg/
examples/panel-set/dwg/
examples/two-kinds/dwg/
examples/transforms/dwg/
!demo-plant/**/*.dwg
!demo-plant/**/*.dxf
!tests/fixtures/**/*.dwg
!tests/fixtures/**/*.dxf

# Secrets
.env
.env.*

# Run files and scratch
.zstack/

# Build output and tool folders
target/
node_modules/
dist/
__pycache__/
*.pyc
.venv/

# The viewer's WebAssembly module and its glue, built by `npm run build`
# in viewer/ (viewer/dist/ is ignored above, as dist/).
viewer/src/wasm/
